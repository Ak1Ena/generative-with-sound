# ===========================================
# Model Configuration
# ===========================================

# Model Provider: 'ollama', 'gemini', or 'openai'
MODEL_PROVIDER=ollama

# Model name based on provider
# - Ollama: qwen3, qwen3-vl, llama3.2, mistral, etc.
# - Gemini: gemini-2.0-flash, gemini-1.5-pro, etc.
# - OpenAI Compatible: google/gemini-2.0-flash-exp:free, openai/gpt-4o, etc.
MODEL=qwen3

# ===========================================
# Gemini API Configuration
# ===========================================
GEMINI_API_KEY=

# ===========================================
# OpenAI Compatible Configuration (OpenRouter, DeepSeek, etc.)
# ===========================================
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1


# ===========================================
# Ollama Configuration
# ===========================================
# Ollama must be running locally (default: http://localhost:11434)
# Only change this if Ollama runs on a different host/port
# OLLAMA_BASE_URL=http://localhost:11434

# ===========================================
# Voice Configuration (ElevenLabs)
# ===========================================
VOICE_CORE_API_KEY=
VOICE_ID=TxGi1N29NQoCaYD4fcU5
VOICE_MODEL=eleven_v3

# ===========================================
# TTS Provider Configuration
# ===========================================
# TTS Provider: 'elevenlabs' or 'qwen-tts'
TTS_PROVIDER=qwen-tts

# Local TTS Configuration
LOCAL_TTS_MODEL_ID=FunAudioLLM/CosyVoice-300M-Instruct
TTS_INSTRUCTION=Speak with a calm, natural, and friendly tone.
